 document.getElementById("sc").textContent=0;document.getElementById("menu").classList.add("hide");requestAnimationFrame(loop)}
function end(why){running=false;try{if(navigator.vibrate)navigator.vibrate([200,80,200,80,350])}catch(e){}if(mout&&ac){mout.gain.cancelScheduledValues(ac.currentTime);mout.gain.setTargetAtTime(0,ac.currentTime,0.01)}boom();
