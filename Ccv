document.getElementById("voc").onclick=function(){voiceOn=!voiceOn;this.classList.toggle("off",!voiceOn);if(voiceOn)speak("Uè, guagliò! Jamme!",true);else{try{speechSynthesis.cancel()}catch(e){}}};
