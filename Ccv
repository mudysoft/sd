function initAudio(){if(!ac){try{ac=new(window.AudioContext||window.webkitAudioContext)();mout=ac.createGain();mout.connect(ac.destination);nextT=ac.currentTime+0.1;setInterval(sched,100)}catch(e){ac=null}}if(ac&&ac.state==="suspended")ac.resume()}
function loadVoices(){try{voices=speechSynthesis.getVoices()||[]}catch(e){}}
if("speechSynthesis" in window){loadVoices();speechSynthesis.onvoiceschanged=loadVoices}
function speaking(){try{return speechSynthesis.speaking||speechSynthesis.pending}catch(e){return false}}
let hinted=false;
function pickVoice(){const l=x=>(x.lang||"").toLowerCase().replace("_","-");return voices.find(x=>l(x).startsWith("it"))||voices.find(x=>l(x).startsWith("en"))||voices.find(x=>x.default)||voices[0]||null}
function speak(t,force){if(!voiceOn||!("speechSynthesis" in window))return;try{loadVoices();if(force&&speaking())speechSynthesis.cancel();try{speechSynthesis.resume()}catch(e){}const u=new SpeechSynthesisUtterance(t.replace(/[^\p{L}\p{N}\s'!?.,]/gu,""));const v=pickVoice();if(v){u.voice=v;u.lang=v.lang}else{u.lang="it-IT"}u.pitch=1.25;u.rate=0.95;u.volume=1;let ok=false;u.onstart=()=>{ok=true};u.onerror=e=>{if(e.error==="interrupted"||e.error==="canceled")return;say="Voce non disponibile 🙈";sayT=1.5};setTimeout(()=>{try{speechSynthesis.speak(u)}catch(e){}},force?80:0);setTimeout(()=>{if(!ok&&!hinted&&voiceOn&&!speechSynthesis.speaking){hinted=true;say="🔇 Il telefono non ha voci";sayT=2.5}},2800)}catch(e){}}
