 const ty=H-70,w=pw();
 face('simon',58,H-26,20,'');ctx.font='700 12px system-ui,sans-serif';ctx.fillStyle='#fff';ctx.textAlign='left';ctx.fillText(simonT>0?simonSay:'Simone · Contabile',84,H-26);ctx.textAlign='center';
 for(let k=money.length-1;k>=0;k--){const m=money[k];m.t+=dt;const q=Math.min(1,m.t/1.1);ctx.font='28px serif';ctx.fillText('💶',58+(W/2-58)*q,H-26+(30-H+26)*q-Math.sin(q*3.14)*60);if(m.t>1.1){money.splice(k,1);document.getElementById('sc').textContent=score}}

 for(const it of items){it.y+=it.v*dt;it.rot+=dt}
 for(let i=items.length-1;i>=0;i--){
