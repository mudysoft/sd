 {const a=IM.art;if(a&&a.complete&&a.naturalWidth){const aw=Math.min(W-70,400),ah=aw*a.naturalHeight/a.naturalWidth;ctx.globalAlpha=0.13;ctx.drawImage(a,(W-aw)/2,H*0.45-ah/2,aw,ah);const sy=H*0.45+ah/2+46;ctx.globalAlpha=0.2;ctx.textAlign='center';ctx.textBaseline='middle';ctx.font="italic 900 60px Georgia,'Times New Roman',serif";ctx.fillStyle='#0d2559';ctx.fillText('SUD',W/2+3,sy+3);ctx.fillStyle='#fff';ctx.fillText('SUD',W/2,sy);ctx.font='600 11px system-ui,sans-serif';ctx.fillText('PIZZA · CUCINA · NAPOLETANA',W/2,sy+38);ctx.globalAlpha=1}}
